# Normalise text to LF in the repository; check out native on Windows.
* text=auto

# Scripts must stay LF or they break when run on Linux.
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf

# Data and model files: never touch.
*.parquet binary
*.npy binary
*.pkl binary
*.png binary
*.pptx binary
*.jsonl -text
